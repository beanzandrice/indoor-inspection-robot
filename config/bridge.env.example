# Copy this file to config/bridge.env and edit values for your current network.
# Do not commit config/bridge.env because it may contain lab-specific addresses.

# Laptop -> Raspberry Pi 3 route.
PI_HOST=10.133.241.86
PI_USER=user

# Raspberry Pi 3 -> Unitree Go2 route.
GO2_HOST=192.168.123.18
GO2_USER=unitree

# Local-only tunnel endpoints.
LAPTOP_RECV_HOST=127.0.0.1
LAPTOP_RECV_PORT=16000
LAPTOP_RETURN_HOST=127.0.0.1
LAPTOP_RETURN_PORT=16001

# GO2 loopback endpoints reached through the SSH tunnel.
GO2_SEND_HOST=127.0.0.1
GO2_SEND_PORT=16000
GO2_RECV_HOST=127.0.0.1
GO2_RECV_PORT=16001

# Optional RViz display support. The camera and point cloud are relayed through
# SSH, so keep these rates modest on hotspot networks.
GO2_CAMERA_ENABLE=false
GO2_CAMERA_FPS=5
GO2_JOINT_TF_ENABLE=true
GO2_LOWSTATE_TOPICS=lowstate,lf/lowstate
GO2_JOINT_TF_HZ=20.0

# Legacy go2_core video path. Keep this false; this project uses its own camera
# publisher because some GO2 installs do not include go2_core/video_stream_node.py.
GO2_VIDEO_ENABLE=false
GO2_RVIZ_TF_MAX_HZ=20.0
GO2_RVIZ_IMAGE_MAX_HZ=0.0
GO2_RVIZ_POINTCLOUD_MAX_HZ=0.5

# Laptop-side robot model publisher. The default path points to the URDF stored
# in this repository.
ENABLE_GO2_MODEL=true
# GO2_URDF=/absolute/path/to/go2-navigation-rviz-project/robot_description/go2/urdf/go2.urdf
