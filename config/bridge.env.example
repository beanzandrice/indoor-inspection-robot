# Copy this file to config/bridge.env and edit values for your current network.
# Do not commit config/bridge.env because it may contain lab-specific addresses.

# Laptop -> Raspberry Pi 3 route.
# Use a fixed address if you know it. If that address goes stale, the scripts
# try to rediscover the Pi on the local /24 by matching its saved SSH host key.
# With PI_HOST=auto, discovery uses PI_MDNS_HOSTS and PI_KNOWN_HOSTS.
PI_HOST=auto
PI_HOST_AUTO_REFRESH=true
PI_MDNS_HOSTS="raspberrypi.local pi.local raspi.local"
# PI_KNOWN_HOSTS=192.0.2.10
PI_USER=user

# Raspberry Pi 3 -> Unitree Go2 route.
GO2_HOST=192.168.123.18
GO2_USER=unitree

# Local-only tunnel endpoints.
LAPTOP_RECV_HOST=127.0.0.1
LAPTOP_RECV_PORT=16000
LAPTOP_RETURN_HOST=127.0.0.1
LAPTOP_RETURN_PORT=16001
# Keep the laptop ROS graph on loopback by default. Set to 0 only on a trusted
# network when an authenticated DDS/SROS2 policy is in place.
LAPTOP_ROS_LOCALHOST_ONLY=1

# GO2 loopback endpoints reached through the SSH tunnel.
GO2_SEND_HOST=127.0.0.1
GO2_SEND_PORT=16000
GO2_RECV_HOST=127.0.0.1
GO2_RECV_PORT=16001

# Optional RViz display support. The camera and point cloud are relayed through
# SSH, so keep these rates modest on hotspot networks.
GO2_CAMERA_ENABLE=false
GO2_CAMERA_FPS=5
GO2_JOINT_TF_ENABLE=true
GO2_LOWSTATE_TOPICS=lowstate,lf/lowstate
GO2_JOINT_TF_HZ=20.0

# Legacy go2_core video path. Keep this false; this project uses its own camera
# publisher because some GO2 installs do not include go2_core/video_stream_node.py.
GO2_VIDEO_ENABLE=false
GO2_RVIZ_PROTOCOL=binary
# The default profile excludes high-bandwidth costmaps. Set this to all, or set
# GO2_RVIZ_DEBUG_ALL_TOPICS=true, only while diagnosing Nav2 behavior.
GO2_RVIZ_TOPIC_ALLOWLIST=default
GO2_RVIZ_DEBUG_ALL_TOPICS=false
# Optional comma-separated overrides, for example: /odom=10,/scan=5
GO2_RVIZ_TOPIC_RATE_LIMITS=""
GO2_RVIZ_TF_MAX_HZ=20.0
# A value of 0 disables a topic's rate limit; the camera itself is off by default.
GO2_RVIZ_IMAGE_MAX_HZ=2.0
GO2_RVIZ_POINTCLOUD_MAX_HZ=0.5
GO2_RVIZ_QUEUE_CAPACITY=32
GO2_RVIZ_MAX_FRAME_BYTES=16777216
GO2_RVIZ_MAX_BUFFER_BYTES=20971520
GO2_RVIZ_WRITE_TIMEOUT=2.0
GO2_COMMAND_MAX_AGE=5.0

# Laptop-side robot model publisher. The default path points to the URDF stored
# in this repository.
ENABLE_GO2_MODEL=true
# GO2_URDF=/path/to/indoor-inspection-robot/robot_description/go2/urdf/go2.urdf
