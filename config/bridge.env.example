# Copy this file to config/bridge.env and edit values for your current network.
# Do not commit config/bridge.env because it may contain lab-specific addresses.

# Laptop -> Raspberry Pi 3 route.
PI_HOST=10.133.241.86
PI_USER=user

# Raspberry Pi 3 -> Unitree Go2 route.
GO2_HOST=192.168.123.18
GO2_USER=unitree

# Local-only tunnel endpoints.
LAPTOP_RECV_HOST=127.0.0.1
LAPTOP_RECV_PORT=16000
LAPTOP_RETURN_HOST=127.0.0.1
LAPTOP_RETURN_PORT=16001

# GO2 loopback endpoints reached through the SSH tunnel.
GO2_SEND_HOST=127.0.0.1
GO2_SEND_PORT=16000
GO2_RECV_HOST=127.0.0.1
GO2_RECV_PORT=16001

